<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="HUDRoot" style="flex-grow: 1;">
        <ui:VisualElement name="HealthBarBackground" style="position: absolute; left: 1%; top: 2%; width: 190px; height: 68px; background-color: rgba(22, 26, 34, 0.82); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
            <ui:VisualElement name="CharacterPortrait" style="position: absolute; left: 8px; top: 7px; width: 42px; height: 52px; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/SugarLand/UI/CharacterPortrait.png?fileID=21300000&amp;guid=e8af26c6841fc05459ccaf23dbab2b63&amp;type=3#CharacterPortrait&quot;); -unity-background-scale-mode: scale-to-fit;" />
            <ui:VisualElement name="HealthBarContainer" style="position: absolute; left: 58px; top: 15px; width: 122px; height: 18px; overflow: hidden; background-color: rgba(255, 255, 255, 0.22); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;">
                <ui:VisualElement name="HealthBar" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/SugarLand/UI/UIHealthBar.png?fileID=21300000&amp;guid=b28ee55f43291f14ab9219808f397b88&amp;type=3#UIHealthBar&quot;); -unity-background-scale-mode: stretch-to-fill;" />
            </ui:VisualElement>
            <ui:Label name="HealthValue" text="ХП 100%" style="position: absolute; left: 58px; top: 37px; width: 122px; height: 22px; font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-left;" />
        </ui:VisualElement>
        <ui:VisualElement name="NPCDialogue" style="position: absolute; left: 8%; right: 8%; bottom: 3%; min-height: 54px; max-height: 100px; background-color: rgba(22, 26, 34, 0.82); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
            <ui:Label name="DialogueText" text="Убий усіх ворогів! Після них з’явиться червоний робот-бос." style="width: 100%; min-height: 54px; padding-left: 24px; padding-right: 24px; padding-top: 12px; padding-bottom: 12px; font-size: 20px; white-space: normal; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        <ui:VisualElement name="StartScreenOverlay" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8, 14, 22, 0.72);">
            <ui:Label name="GameTitle" text="ROBOT REPAIR" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 23%; height: 72px; font-size: 48px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
            <ui:Label name="GameGoal" text="Полагодь роботів, збери аптечки та переможи червоного боса." picking-mode="Ignore" style="position: absolute; left: 8%; right: 8%; top: 38%; height: 56px; font-size: 24px; color: rgb(222, 250, 255); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>
        <ui:Button text="Почати гру" name="start-button" style="position: absolute; width: 163px; height: 64px; left: 43%; top: 66%; font-size: 20px;" />
        <ui:VisualElement name="WinScreenContainer" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; flex-grow: 1; background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 1s; transition-timing-function: ease;">
            <ui:VisualElement name="WinScreen" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/WinScreen.png?fileID=-848381713617584042&amp;guid=d46766d63d5ca44c6b1a4d318b1eaf72&amp;type=3#WinScreen_0&quot;); -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>
        <ui:VisualElement name="LoseScreenContainer" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; flex-grow: 1; background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 1s; transition-timing-function: ease;">
            <ui:VisualElement name="LoseScreen" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/LoseScreen.png?fileID=2800000&amp;guid=68999694f4e00437a8c4f0b6053e3d45&amp;type=3#LoseScreen&quot;); -unity-background-scale-mode: scale-to-fit;" />
            <ui:Label name="LoseTitle" text="ПОРАЗКА" picking-mode="Ignore" style="display: none; position: absolute; left: 0; right: 0; top: 42%; height: 90px; font-size: 72px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
